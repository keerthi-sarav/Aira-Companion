# Copy to backend/.env and adjust. Never commit real keys.

# Dev default. Prod: postgresql+asyncpg://user:pass@host:5432/aira  (pip install -e ".[prod]")
DATABASE_URL=sqlite+aiosqlite:///./aira.db

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Max companion replies running at once (extra callers wait 5 s, then 503)
COMPANION_MAX_CONCURRENT=4

# fake | openai_compat
LLM_PROVIDER=fake
# OpenAI-compatible endpoint, e.g. Groq, Gemini-OpenAI, Sarvam
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
